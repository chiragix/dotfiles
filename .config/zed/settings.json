// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "languages": {
    "C": {
      "show_edit_predictions": false
    }
  },
  "auto_indent": "syntax_aware",
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "fixed"
  },
  "project_panel": {
    "dock": "right",
    "scrollbar": {
      "show": "never",
    },
    "indent_guides": {
      "show": "never",
    },
  },

  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },

  "show_edit_predictions": false,
  "edit_predictions": {
    "provider": "copilot",
    "allow_data_collection": "no"
  },
  "agent": {
    "sidebar_side": "left",
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
    "enable_feedback": false
  },
  "proxy": "",
  "terminal": {
    "copy_on_select": true,
    "cursor_shape": "block"
  },
  "use_smartcase_search": true,
  "prettier": {
    "parser": ""
  },
  "colorize_brackets": true,
  "format_on_save": "modifications",
  "toolbar": {
    "code_actions": true,
    "quick_actions": false,
  },
  "tab_size": 2,
  "vim": {
    "cursor_shape": {
      "insert": "block"
    },
    "use_smartcase_find": true,
    "highlight_on_yank_duration": 80,
    "use_system_clipboard": "on_yank",
    "toggle_relative_line_numbers": true
  },
  "relative_line_numbers": "enabled",
  "tabs": {
    "file_icons": true,
    "close_position": "right"
  },
  "title_bar": {
    "show_sign_in": true,
    "show_branch_status_icon": false,
    "show_project_items": false,
    "show_branch_name": true,
    "show_user_menu": true,
  },
  "tab_bar": {
    "show": true,
  },
  "status_bar": {
      "experimental.show": true,
      "line_endings_button": false,
  },
  "reduce_motion": "off",
  "markdown_preview_code_font_family": "JetBrainsMono Nerd Font Mono",
  "markdown_preview_font_family": "JetBrainsMono Nerd Font Mono",
  "base_keymap": "Zed",
  "ui_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "icon_theme": {
    "mode": "system",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "vim_mode": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "ui_font_size": 16,
  "buffer_font_size": 16.0,
  "theme": {
    "mode": "system",
    "light": "Rosé Pine",
    "dark": "Rosé Pine",
  },
  "scrollbar": {
    "show": "never",
  },
  "gutter": {
    "min_line_number_digits": 4,
    "folds": false,
  },
  "cursor_shape": "block",
  "cursor_blink": false,
  "selection_highlight": false,
  "drag_and_drop_selection": {
    "enabled": false,
  },
  "seed_search_query_from_cursor": "never",
  "show_whitespaces": "none",
  "current_line_highlight": "none",
  "show_completion_documentation": false,
  "inline_code_actions": false,
  "hover_popover_enabled": false,

  "extend_comment_on_newline": false,
  "horizontal_scroll_margin": 1,
  "vertical_scroll_margin": 8,
  "when_closing_with_no_tabs": "keep_window_open",
  "close_on_file_delete": true,
  "restore_on_file_reopen": true,
  "session": {
    "restore_unsaved_buffers": false,
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "lsp": {
    "clangd": {
      "binary": {
        "path": "/usr/bin/clangd",
        "arguments": []
      }
    }
  }
}
